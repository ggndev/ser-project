              "pm.test(\"responds within 60 s\", () => pm.expect(pm.response.responseTime).to.be.below(60000));",
              "pm.test(\"multiple windows (capped at 4)\", () => { const n=pm.response.json().windows.length; pm.expect(n).to.be.within(2,4); });"
            ]
